{
  "name": "nearfind-demo",
  "version": "1.0.0",
  "private": true,
  "description": "NearFind static citizen-app demo with Node.js deployment tooling",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "validate": "node scripts/validate-static.js",
    "dev": "node scripts/dev.js",
